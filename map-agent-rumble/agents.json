      "skillPack": "stadiamaps/stadiamaps-mcp-server-ts (MCP server)",
      "localPath": null,
      "status": "mcp",
      "note": "Official Stadia Maps MCP server (geocoding, routing, isochrones, static maps). No Cursor Agent Skills pack — use MCP + MapLibre for packs."
    },
