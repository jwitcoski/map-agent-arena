{
  "version": 1,
  "agents": {
    "google": {
      "url": "https://github.com/googlemaps/agent-skills",
      "docsUrl": "https://github.com/googlemaps/agent-skills#readme",
      "install": "npx skills add googlemaps/agent-skills -a cursor",
      "skillPack": "googlemaps/agent-skills → .agents/skills/google-maps-platform",
      "localPath": ".agents/skills/google-maps-platform",
      "status": "installed"
    },
    "mapbox": {
      "url": "https://github.com/mapbox/mapbox-agent-skills",
      "docsUrl": "https://docs.mapbox.com/api/guides/mapbox-agent-skills/",
